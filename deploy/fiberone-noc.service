[Unit]
Description=FiberOne NOC Dashboard (FastAPI)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=powermonitoring
Group=powermonitoring
WorkingDirectory=/home/powermonitoring
EnvironmentFile=-/home/powermonitoring/.env
ExecStart=/home/powermonitoring/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8080
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
